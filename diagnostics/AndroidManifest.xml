<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.pulserelay.blecheck">
  <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="31"/>
  <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation"/>
  <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
  <application android:label="PulseRelay BLE Check" android:theme="@android:style/Theme.Material.Light.NoActionBar">
    <activity android:name=".MainActivity" android:exported="true"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity>
  </application>
</manifest>
